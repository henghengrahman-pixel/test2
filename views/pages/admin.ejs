<div class="admin-layout">

  <!-- Sidebar -->
  <aside class="admin-sidebar">
    <div class="admin-logo">MAWAR ADMIN</div>

    <nav class="admin-menu">
      <a href="/admin" class="<%= currentTab === 'dashboard' ? 'active' : '' %>">Dashboard</a>
      <a href="/admin/products" class="<%= currentTab === 'products' ? 'active' : '' %>">Products</a>
      <a href="/admin/orders" class="<%= currentTab === 'orders' ? 'active' : '' %>">Orders</a>
      <a href="/admin/settings" class="<%= currentTab === 'settings' ? 'active' : '' %>">Settings</a>
      <a href="/" target="_blank">View Store</a>

      <form method="post" action="/admin/logout">
        <button type="submit" class="logout-btn">Logout</button>
      </form>
    </nav>
  </aside>

  <!-- Content -->
  <main class="admin-content">

    <% if (currentTab === 'dashboard') { %>
      <h1>Dashboard</h1>

      <div class="admin-stats">
        <div class="stat-card">
          <div>Total Products</div>
          <strong><%= stats.totalProducts %></strong>
        </div>

        <div class="stat-card">
          <div>Total Orders</div>
          <strong><%= stats.totalOrders %></strong>
        </div>

        <div class="stat-card">
          <div>Total Revenue</div>
          <strong>Rp <%= Number(stats.totalRevenue).toLocaleString('id-ID') %></strong>
        </div>
      </div>

      <div class="admin-table">
        <h2>Recent Orders</h2>
        <table>
          <thead>
            <tr>
              <th>Order Code</th>
              <th>Customer</th>
              <th>Total</th>
              <th>Date</th>
            </tr>
          </thead>
          <tbody>
            <% stats.recentOrders.forEach(function(order){ %>
              <tr>
                <td><%= order.orderCode %></td>
                <td><%= order.customer.name %></td>
                <td>Rp <%= Number(order.totals.grandTotal).toLocaleString('id-ID') %></td>
                <td><%= new Date(order.createdAt).toLocaleString('id-ID') %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>


    <% if (currentTab === 'products') { %>
      <h1>Products</h1>

      <form method="post" action="/admin/products/save" class="admin-form">
        <input type="hidden" name="id" value="<%= editingProduct?.id || '' %>">

        <label>Nama Produk</label>
        <input name="name" value="<%= editingProduct?.name || '' %>" required>

        <label>Harga</label>
        <input name="price" value="<%= editingProduct?.price || '' %>" required>

        <label>Image</label>
        <input name="image" value="<%= editingProduct?.image || '' %>">

        <button type="submit">Simpan Produk</button>
      </form>

      <table class="admin-table">
        <thead>
          <tr>
            <th>Produk</th>
            <th>Harga</th>
            <th>Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% products.forEach(function(product){ %>
          <tr>
            <td><%= product.name %></td>
            <td>Rp <%= Number(product.price).toLocaleString('id-ID') %></td>
            <td>
              <a href="/admin/products?edit=<%= product.id %>">Edit</a>
              <form method="post" action="/admin/products/<%= product.id %>/delete" style="display:inline;">
                <button type="submit">Hapus</button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>


    <% if (currentTab === 'orders') { %>
      <h1>Orders</h1>

      <table class="admin-table">
        <thead>
          <tr>
            <th>Kode</th>
            <th>Customer</th>
            <th>Total</th>
            <th>Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% orders.forEach(function(order){ %>
          <tr>
            <td><%= order.orderCode %></td>
            <td><%= order.customer.name %></td>
            <td>Rp <%= Number(order.totals.grandTotal).toLocaleString('id-ID') %></td>
            <td>
              <form method="post" action="/admin/orders/<%= order.orderCode %>/delete">
                <button type="submit">Hapus</button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>


    <% if (currentTab === 'settings') { %>
      <h1>Settings</h1>

      <form method="post" action="/admin/settings/save" class="admin-form">
        <label>App Name</label>
        <input name="appName" value="<%= settings.appName %>">

        <label>WhatsApp</label>
        <input name="whatsappLink" value="<%= settings.whatsappLink %>">

        <label>Email</label>
        <input name="contactEmail" value="<%= settings.contactEmail %>">

        <button type="submit">Simpan Settings</button>
      </form>
    <% } %>

  </main>
</div>
