<div class="crumbrow">
  <div class="wrap">
    <div class="crumbtxt">
      <a href="/">Home</a>
      <span class="sep">›</span>
      <a href="/">Fragrance</a>
      <span class="sep">›</span>
      <span class="pname"><%= product.name %></span>
    </div>
  </div>
</div>

<main class="wrap pdp-wrap">
  <div class="pdp">
    <section class="pdp-left reveal reveal-left">
      <div class="pdp-badges">
        <% if (product.badge) { %><span class="pill"><%= product.badge %></span><% } %>
        <% if (product.topSeller) { %><span class="pill">Top Seller</span><% } %>
        <% if (product.soldOut) { %><span class="pill soldout-pill">Sold Out</span><% } %>
      </div>

      <div class="pdp-image">
        <img id="pImage" src="<%= product.image %>" alt="<%= product.name %>">
      </div>

      <% if (product.gallery && product.gallery.length) { %>
      <div class="pdp-thumbs" id="thumbs">
        <% product.gallery.forEach(function(image, index){ %>
          <button class="thumb <%= index === 0 ? 'active' : '' %>" data-image="<%= image %>" type="button">
            <img src="<%= image %>" alt="<%= product.name %>">
          </button>
        <% }) %>
      </div>
      <% } %>
    </section>

    <section class="pdp-right reveal reveal-right">
      <div class="pdp-meta-top">
        <h1 class="pdp-title"><%= product.name %></h1>

        <div class="pdp-price">
          Rp <%= Number(product.price).toLocaleString('id-ID') %>
        </div>
      </div>

      <div class="pdp-desc">
        <%= product.description || product.desc %>
      </div>

      <div class="notes-grid">
        <div class="note-card">
          <strong>Top Notes</strong>
          <div><%= product.topNotes || '-' %></div>
        </div>
        <div class="note-card">
          <strong>Mid Notes</strong>
          <div><%= product.midNotes || '-' %></div>
        </div>
        <div class="note-card">
          <strong>Base Notes</strong>
          <div><%= product.baseNotes || '-' %></div>
        </div>
      </div>

      <div class="pdp-cta">
        <div class="qty">
          <button type="button" id="minus">−</button>
          <input id="qty" type="number" min="1" value="1">
          <button type="button" id="plus">+</button>
        </div>

        <button
          class="btn-cart"
          id="addProductCart"
          data-id="<%= product.id %>"
          data-name="<%= product.name %>"
          data-price="<%= product.price %>"
          <%= product.soldOut ? 'disabled' : '' %>>
          <%= product.soldOut ? 'Sold Out' : 'Add to Cart' %>
        </button>

        <a class="btn-checkout" href="/checkout">Checkout</a>
      </div>
    </section>
  </div>

  <% if (relatedProducts && relatedProducts.length) { %>
  <section class="related reveal">
    <h2>Produk Lainnya</h2>

    <div class="related-grid">
      <% relatedProducts.forEach(function(item, index){ %>
      <article class="product-card related-card reveal delay-<%= (index % 4) + 1 %>">
        <a href="/product/<%= item.slug %>" class="related-image-link">
          <img src="<%= item.image %>" alt="<%= item.name %>">
        </a>

        <div class="card-body">
          <h3><a href="/product/<%= item.slug %>"><%= item.name %></a></h3>
          <div class="muted related-desc"><%= item.desc %></div>
          <div class="related-price">Rp <%= Number(item.price).toLocaleString('id-ID') %></div>
        </div>
      </article>
      <% }) %>
    </div>
  </section>
  <% } %>
</main>

<style>
  .pdp-wrap{
    padding:22px 0 56px;
  }

  .crumbrow{
    border-bottom:1px solid #ece8e1;
    background:#fff;
  }

  .crumbrow .wrap{
    padding-top:10px;
    padding-bottom:10px;
  }

  .crumbtxt{
    display:flex;
    align-items:center;
    gap:8px;
    flex-wrap:wrap;
    color:#777;
    font-size:11px;
    letter-spacing:.08em;
    text-transform:uppercase;
  }

  .crumbtxt .pname{
    color:#181818;
    font-weight:700;
  }

  .pdp{
    display:grid;
    grid-template-columns:minmax(0, 1.02fr) minmax(320px, .98fr);
    gap:30px;
    align-items:start;
  }

  .pdp-left,
  .pdp-right{
    min-width:0;
  }

  .pdp-badges{
    display:flex;
    gap:8px;
    flex-wrap:wrap;
    margin-bottom:12px;
  }

  .pdp-image{
    border:1px solid #ece8e1;
    border-radius:24px;
    background:linear-gradient(180deg,#ffffff,#faf8f4);
    box-shadow:0 12px 28px rgba(0,0,0,.05);
    overflow:hidden;
    aspect-ratio:1/1.08;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:18px;
  }

  .pdp-image img{
    width:100%;
    height:100%;
    object-fit:contain;
    max-width:520px;
    max-height:620px;
    transition:transform .35s ease;
  }

  .pdp-image:hover img{
    transform:scale(1.02);
  }

  .pdp-thumbs{
    display:flex;
    gap:10px;
    margin-top:14px;
    flex-wrap:wrap;
  }

  .thumb{
    width:74px;
    height:74px;
    border:1px solid #ece8e1;
    background:#fff;
    border-radius:14px;
    padding:4px;
    display:flex;
    align-items:center;
    justify-content:center;
    box-shadow:0 8px 18px rgba(0,0,0,.04);
    transition:transform .22s ease, border-color .22s ease, background .22s ease;
  }

  .thumb:hover{
    transform:translateY(-2px);
    border-color:rgba(216,179,106,.5);
    background:#faf8f4;
  }

  .thumb.active{
    border-color:rgba(216,179,106,.62);
    background:#faf6ee;
  }

  .thumb img{
    width:100%;
    height:100%;
    object-fit:cover;
    border-radius:10px;
  }

  .pdp-right{
    padding-top:8px;
  }

  .pdp-meta-top{
    display:flex;
    flex-direction:column;
    gap:8px;
  }

  .pdp-title{
    margin:0;
    font-size:34px;
    line-height:1.2;
    letter-spacing:.04em;
    color:#181818;
  }

  .pdp-price{
    font-size:30px;
    font-weight:900;
    color:#7a2946;
    line-height:1.2;
  }

  .pdp-desc{
    margin-top:14px;
    line-height:1.9;
    color:#666;
    font-size:15px;
  }

  .notes-grid{
    display:grid;
    grid-template-columns:repeat(3, minmax(0,1fr));
    gap:12px;
    margin-top:22px;
  }

  .note-card{
    border:1px solid #ece8e1;
    border-radius:16px;
    padding:14px;
    background:#fff;
    box-shadow:0 8px 20px rgba(0,0,0,.04);
  }

  .note-card strong{
    display:block;
    margin-bottom:6px;
    color:#1c1c1c;
    font-size:13px;
  }

  .note-card div{
    color:#666;
    font-size:14px;
    line-height:1.7;
  }

  .pdp-cta{
    display:flex;
    gap:12px;
    margin-top:22px;
    flex-wrap:wrap;
    align-items:center;
  }

  .qty{
    display:flex;
    align-items:center;
    gap:8px;
    padding:6px;
    border:1px solid #ece8e1;
    border-radius:16px;
    background:#fff;
    box-shadow:0 8px 18px rgba(0,0,0,.04);
  }

  .qty button{
    width:40px;
    height:40px;
    border:1px solid #ece8e1;
    background:#fff;
    border-radius:12px;
    color:#1b1b1b;
    font-size:18px;
    transition:background .22s ease, border-color .22s ease, transform .22s ease;
  }

  .qty button:hover{
    background:#faf8f4;
    border-color:#ddd5c7;
    transform:translateY(-1px);
  }

  .qty input{
    width:78px;
    min-height:40px;
    text-align:center;
    border:1px solid #ece8e1;
    border-radius:12px;
    background:#fff;
    color:#111;
    font-weight:700;
    outline:none;
  }

  .btn-cart,
  .btn-checkout{
    min-height:46px;
    padding:0 18px;
    border-radius:14px;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    font-size:11px;
    font-weight:800;
    letter-spacing:.10em;
    text-transform:uppercase;
    transition:transform .22s ease, box-shadow .22s ease, border-color .22s ease;
  }

  .btn-cart{
    border:1px solid rgba(216,179,106,.45);
    background:linear-gradient(180deg,#f5e6c7,#e3c085);
    color:#2c1d08;
    box-shadow:0 10px 22px rgba(216,179,106,.16);
  }

  .btn-checkout{
    border:1px solid #ece8e1;
    background:#fff;
    color:#222;
    box-shadow:0 8px 18px rgba(0,0,0,.04);
  }

  .btn-cart:hover,
  .btn-checkout:hover{
    transform:translateY(-2px);
  }

  .btn-cart[disabled]{
    opacity:.55;
    cursor:not-allowed;
  }

  .related{
    margin-top:44px;
  }

  .related h2{
    margin:0 0 16px;
    color:#181818;
    letter-spacing:.08em;
    text-transform:uppercase;
    font-size:24px;
  }

  .related-grid{
    display:grid;
    grid-template-columns:repeat(4, minmax(0,1fr));
    gap:18px;
  }

  .related-card{
    border-radius:20px;
    overflow:hidden;
    border:1px solid #ece8e1;
    background:#fff;
    box-shadow:0 10px 24px rgba(0,0,0,.05);
    transition:transform .22s ease, border-color .22s ease, box-shadow .22s ease;
  }

  .related-card:hover{
    transform:translateY(-4px);
    border-color:rgba(216,179,106,.45);
    box-shadow:0 18px 36px rgba(0,0,0,.08);
  }

  .related-image-link{
    display:block;
    overflow:hidden;
    background:#faf8f4;
    aspect-ratio:3/4;
  }

  .related-card img{
    width:100%;
    height:100%;
    object-fit:cover;
    transition:transform .35s ease;
  }

  .related-card:hover img{
    transform:scale(1.04);
  }

  .related-card .card-body{
    padding:14px;
  }

  .related-card h3{
    margin:0 0 8px;
    font-size:15px;
    line-height:1.4;
  }

  .related-card h3 a{
    color:#181818;
  }

  .related-desc{
    font-size:13px;
    line-height:1.7;
    min-height:38px;
  }

  .related-price{
    margin-top:10px;
    color:#7a2946;
    font-weight:800;
    font-size:14px;
  }

  .reveal{
    opacity:0;
    transform:translateY(28px);
    transition:opacity .8s ease, transform .8s ease;
    will-change:opacity, transform;
  }

  .reveal.is-visible{
    opacity:1;
    transform:translateY(0);
  }

  .reveal-left{
    opacity:0;
    transform:translateX(-30px);
    transition:opacity .8s ease, transform .8s ease;
  }

  .reveal-left.is-visible{
    opacity:1;
    transform:translateX(0);
  }

  .reveal-right{
    opacity:0;
    transform:translateX(30px);
    transition:opacity .8s ease, transform .8s ease;
  }

  .reveal-right.is-visible{
    opacity:1;
    transform:translateX(0);
  }

  .delay-1{transition-delay:.08s}
  .delay-2{transition-delay:.16s}
  .delay-3{transition-delay:.24s}
  .delay-4{transition-delay:.32s}
  .delay-5{transition-delay:.40s}

  @media (max-width:1100px){
    .related-grid{
      grid-template-columns:repeat(3, minmax(0,1fr));
    }
  }

  @media (max-width:900px){
    .pdp{
      grid-template-columns:1fr;
      gap:26px;
    }

    .notes-grid{
      grid-template-columns:1fr;
    }

    .related-grid{
      grid-template-columns:repeat(2, minmax(0,1fr));
    }

    .pdp-image{
      aspect-ratio:1/1;
    }
  }

  @media (max-width:600px){
    .pdp-wrap{
      padding:18px 0 50px;
    }

    .pdp-title{
      font-size:24px;
    }

    .pdp-price{
      font-size:24px;
    }

    .pdp-desc{
      font-size:13px;
      line-height:1.8;
    }

    .thumb{
      width:64px;
      height:64px;
    }

    .pdp-cta{
      flex-direction:column;
      align-items:stretch;
    }

    .qty{
      width:100%;
      justify-content:space-between;
    }

    .qty input{
      flex:1;
      width:auto;
    }

    .btn-cart,
    .btn-checkout{
      width:100%;
      min-height:42px;
      font-size:10px;
    }

    .related{
      margin-top:36px;
    }

    .related h2{
      font-size:20px;
      letter-spacing:.06em;
    }

    .related-grid{
      grid-template-columns:1fr 1fr;
      gap:12px;
    }

    .related-card .card-body{
      padding:10px;
    }

    .related-card h3{
      font-size:12px;
      margin-bottom:6px;
    }

    .related-desc{
      font-size:11px;
      min-height:auto;
    }

    .related-price{
      font-size:12px;
      margin-top:8px;
    }
  }

  @media (max-width:420px){
    .related-grid{
      grid-template-columns:1fr;
    }
  }

  @media (prefers-reduced-motion: reduce){
    .thumb,
    .related-card,
    .btn-cart,
    .btn-checkout,
    .pdp-image img{
      transition:none !important;
      transform:none !important;
    }
  }
</style>
