<section class="hero hero-lux">
  <div class="hero-lux-bg"></div>
  <div class="hero-lux-overlay"></div>

  <div class="wrap hero-lux-inner">
    <div class="hero-kicker">Luxury Extrait de Parfum</div>
    <h1>MAWAR PARFUME</h1>
    <p>
      Extrait de parfum halal, wangi mewah, elegan, dan tahan lama
      untuk pria maupun wanita.
    </p>

    <div class="hero-actions">
      <a href="#productsSection" class="btn-lux btn-lux-gold">Shop Collection</a>
      <a href="#aboutBrand" class="btn-lux btn-lux-dark">About Brand</a>
    </div>

    <div class="hero-features">
      <span>Halal</span>
      <span>Long Lasting</span>
      <span>Premium Quality</span>
      <span>Refill Available</span>
    </div>
  </div>
</section>

<section class="brand-strip">
  <div class="wrap brand-strip-row">
    <div class="brand-item">Luxury Scent</div>
    <div class="brand-dot"></div>
    <div class="brand-item">Elegant Aroma</div>
    <div class="brand-dot"></div>
    <div class="brand-item">Premium Collection</div>
    <div class="brand-dot"></div>
    <div class="brand-item">Mawar Parfume</div>
  </div>
</section>

<% const bestSellerProducts = products.filter(product => product.topSeller && !product.soldOut).slice(0, 4); %>

<% if (bestSellerProducts.length) { %>
<section class="wrap best-section">
  <div class="section-head luxury-head">
    <div>
      <div class="section-kicker">Best Seller</div>
      <h2>Most Loved Fragrance</h2>
    </div>
    <p class="section-subtext">Pilihan aroma favorit pelanggan Mawar Parfume.</p>
  </div>

  <div class="best-grid">
    <% bestSellerProducts.forEach(function(product){ %>
      <article class="best-card">
        <a href="/product/<%= product.slug %>" class="best-image-link">
          <img src="<%= product.image %>" alt="<%= product.name %>" class="best-image">
        </a>

        <div class="best-body">
          <div class="best-badge">TOP SELLER</div>
          <h3><a href="/product/<%= product.slug %>"><%= product.name %></a></h3>
          <p><%= product.desc %></p>

          <div class="best-footer">
            <strong>Rp <%= Number(product.price).toLocaleString('id-ID') %></strong>
            <a href="/product/<%= product.slug %>" class="best-link">Lihat Detail</a>
          </div>
        </div>
      </article>
    <% }) %>
  </div>
</section>
<% } %>

<section class="wrap about-brand-section" id="aboutBrand">
  <div class="about-brand-card">
    <div class="about-brand-content">
      <div class="section-kicker">About Brand</div>
      <h2>Mawar Parfume, Aroma Mewah untuk Penampilan Berkelas</h2>
      <p>
        Mawar Parfume menghadirkan extrait de parfum halal dengan karakter aroma
        yang elegan, premium, dan tahan lama. Dirancang untuk kamu yang ingin tampil
        lebih percaya diri dengan wangi yang berkesan mewah setiap hari.
      </p>

      <div class="about-points">
        <span>Extrait de Parfum</span>
        <span>Halal Formula</span>
        <span>Elegant Scent</span>
        <span>Daily Luxury</span>
      </div>
    </div>
  </div>
</section>

<section class="wrap why-section">
  <div class="section-head luxury-head center">
    <div>
      <div class="section-kicker">Why Choose Us</div>
      <h2>Luxury in Every Spray</h2>
    </div>
  </div>

  <div class="why-grid">
    <article class="why-card">
      <div class="why-icon">✦</div>
      <h3>Premium Aroma</h3>
      <p>Wangi elegan dengan karakter mewah dan berkelas.</p>
    </article>

    <article class="why-card">
      <div class="why-icon">✦</div>
      <h3>Long Lasting</h3>
      <p>Aroma tahan lama untuk aktivitas harian hingga acara spesial.</p>
    </article>

    <article class="why-card">
      <div class="why-icon">✦</div>
      <h3>Halal Formula</h3>
      <p>Dipilih untuk kenyamanan penggunaan sehari-hari.</p>
    </article>

    <article class="why-card">
      <div class="why-icon">✦</div>
      <h3>Luxury Experience</h3>
      <p>Tampilan produk dan branding dibuat premium dan eksklusif.</p>
    </article>
  </div>
</section>

<main class="wrap home-products-wrap" id="productsSection">
  <div class="collection-head">
    <div>
      <div class="collection-label">Collection</div>
      <h2 class="collection-title">Signature Fragrance</h2>
    </div>
    <div class="muted result-info" id="resultInfo"><%= products.length %> produk aktif</div>
  </div>

  <% if (products && products.length) { %>
    <section class="products-grid products-grid-home" id="productsGrid">
      <% products.forEach(function(product){ %>
        <article class="product-card product-card-home">
          <a href="/product/<%= product.slug %>" class="product-image-link">
            <div class="product-image-wrap">
              <img src="<%= product.image %>" alt="<%= product.name %>" class="product-image">
            </div>
          </a>

          <div class="product-body">
            <div class="product-badges">
              <% if (product.badge) { %>
                <span class="product-pill"><%= product.badge %></span>
              <% } %>
              <% if (product.topSeller) { %>
                <span class="product-pill">TOP SELLER</span>
              <% } %>
              <% if (product.soldOut) { %>
                <span class="product-pill soldout-pill">SOLD OUT</span>
              <% } %>
            </div>

            <h3 class="product-name">
              <a href="/product/<%= product.slug %>"><%= product.name %></a>
            </h3>

            <div class="product-desc"><%= product.desc %></div>

            <div class="product-footer">
              <strong class="product-price">
                Rp <%= Number(product.price).toLocaleString('id-ID') %>
              </strong>

              <div class="product-actions">
                <a class="checkout-link detail-btn" href="/product/<%= product.slug %>">Detail</a>

                <button
                  class="iconbtn add-cart add-btn"
                  type="button"
                  data-id="<%= product.id %>"
                  data-name="<%= product.name %>"
                  data-price="<%= product.price %>"
                  <%= product.soldOut ? 'disabled' : '' %>>
                  <%= product.soldOut ? 'Sold Out' : 'Add' %>
                </button>
              </div>
            </div>
          </div>
        </article>
      <% }) %>
    </section>
  <% } else { %>
    <section class="empty-products">
      <div class="empty-products-card">
        <h3>Produk belum tersedia</h3>
        <p class="muted">Saat ini belum ada produk aktif yang ditampilkan.</p>
      </div>
    </section>
  <% } %>
</main>

<section class="wrap testimonial-section">
  <div class="section-head luxury-head center">
    <div>
      <div class="section-kicker">Testimonial</div>
      <h2>What They Say</h2>
    </div>
  </div>

  <div class="testimonial-grid">
    <article class="testimonial-card">
      <p>"Wanginya elegan banget, awet dipakai seharian dan terasa premium."</p>
      <strong>— Customer Mawar</strong>
    </article>

    <article class="testimonial-card">
      <p>"Packaging dan aroma sama-sama mewah. Cocok buat dipakai harian."</p>
      <strong>— Happy Buyer</strong>
    </article>

    <article class="testimonial-card">
      <p>"Favorit saya karena wanginya soft tapi tetap berkelas dan tahan lama."</p>
      <strong>— Loyal Customer</strong>
    </article>
  </div>
</section>

