<section class="hero">
  <h1>MAWAR PARFUME</h1>
  <p>Extrait de parfum halal, wangi mewah, dan tahan lama.</p>
</section>

<main class="wrap home-products-wrap">
  <div class="collection-head">
    <div>
      <div class="collection-label">Collection</div>
      <h2 class="collection-title">Signature Fragrance</h2>
    </div>
    <div class="muted result-info" id="resultInfo"><%= products.length %> produk aktif</div>
  </div>

  <% if (products && products.length) { %>
    <section class="products-grid products-grid-home" id="productsGrid">
      <% products.forEach(function(product){ %>
        <article class="product-card product-card-home">
          <a href="/product/<%= product.slug %>" class="product-image-link">
            <div class="product-image-wrap">
              <img src="<%= product.image %>" alt="<%= product.name %>" class="product-image">
            </div>
          </a>

          <div class="product-body">
            <div class="product-badges">
              <% if (product.badge) { %>
                <span class="product-pill"><%= product.badge %></span>
              <% } %>
              <% if (product.topSeller) { %>
                <span class="product-pill">TOP SELLER</span>
              <% } %>
              <% if (product.soldOut) { %>
                <span class="product-pill soldout-pill">SOLD OUT</span>
              <% } %>
            </div>

            <h3 class="product-name">
              <a href="/product/<%= product.slug %>"><%= product.name %></a>
            </h3>

            <div class="product-desc"><%= product.desc %></div>

            <div class="product-footer">
              <strong class="product-price">
                Rp <%= Number(product.price).toLocaleString('id-ID') %>
              </strong>

              <div class="product-actions">
                <a class="checkout-link detail-btn" href="/product/<%= product.slug %>">Detail</a>

                <button
                  class="iconbtn add-cart add-btn"
                  type="button"
                  data-id="<%= product.id %>"
                  data-name="<%= product.name %>"
                  data-price="<%= product.price %>"
                  <%= product.soldOut ? 'disabled' : '' %>>
                  <%= product.soldOut ? 'Sold Out' : 'Add' %>
                </button>
              </div>
            </div>
          </div>
        </article>
      <% }) %>
    </section>
  <% } %>
</main>

<style>
.home-products-wrap{
  padding:28px 18px 54px;
}

.collection-head{
  display:flex;
  justify-content:space-between;
  gap:12px;
  align-items:end;
  flex-wrap:wrap;
  margin-bottom:18px;
}

.collection-label{
  font-size:12px;
  letter-spacing:.12em;
  text-transform:uppercase;
  color:rgba(255,255,255,.68);
}

.collection-title{
  margin:6px 0 0;
  font-size:18px;
  letter-spacing:.18em;
  text-transform:uppercase;
  color:#fff4d6;
}

/* GRID */
.products-grid-home{
  display:grid;
  grid-template-columns:repeat(5, minmax(0, 1fr));
  gap:16px;
}

/* Laptop */
@media (max-width:1200px){
  .products-grid-home{
    grid-template-columns:repeat(4, minmax(0, 1fr));
  }
}

/* Tablet */
@media (max-width:900px){
  .products-grid-home{
    grid-template-columns:repeat(3, minmax(0, 1fr));
  }
}

/* Mobile */
@media (max-width:600px){
  .products-grid-home{
    grid-template-columns:repeat(2, minmax(0, 1fr));
    gap:12px;
  }
}

/* CARD */
.product-card-home{
  border:1px solid rgba(255,255,255,.08);
  border-radius:16px;
  overflow:hidden;
  background:rgba(255,255,255,.04);
  box-shadow:var(--lux-shadow2);
  display:flex;
  flex-direction:column;
}

.product-image{
  width:100%;
  aspect-ratio:3/4;
  object-fit:cover;
}

.product-body{
  padding:14px;
  display:flex;
  flex-direction:column;
}

.product-badges{
  display:flex;
  gap:6px;
  flex-wrap:wrap;
  margin-bottom:8px;
}

.product-pill{
  padding:4px 8px;
  border-radius:999px;
  border:1px solid rgba(231,192,107,.35);
  color:#fff4d6;
  font-size:10px;
}

.soldout-pill{
  border-color:rgba(255,120,120,.35);
  color:#ffd0d0;
}

.product-name{
  margin:0 0 6px;
  font-size:15px;
}

.product-desc{
  font-size:13px;
  color:rgba(255,255,255,.72);
}

.product-footer{
  margin-top:auto;
  display:flex;
  flex-direction:column;
  gap:8px;
}

.product-price{
  color:#fff4d6;
  font-size:16px;
}

.product-actions{
  display:flex;
  gap:6px;
  flex-direction:column;
}

.detail-btn,
.add-btn{
  width:100%;
  font-size:11px;
  min-height:32px;
}
</style>
