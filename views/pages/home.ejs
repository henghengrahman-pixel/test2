<section class="hero hero-premium">
  <div class="wrap hero-premium-inner">
    <div class="hero-premium-copy">
      <div class="hero-mini">Luxury Extrait de Parfum</div>
      <h1>MAWAR PARFUME</h1>
      <p>
        Parfum halal dengan aroma mewah, elegan, dan tahan lama
        untuk melengkapi penampilan yang lebih berkelas.
      </p>

      <div class="hero-actions">
        <a href="#productsSection" class="btn-premium btn-gold">
          Shop Collection
        </a>
      </div>
    </div>
  </div>
</section>

<% const featuredProducts = products.filter(product => product.topSeller && !product.soldOut).slice(0, 4); %>

<% if (featuredProducts.length) { %>
<section class="wrap featured-section">
  <div class="section-head-clean">
    <div>
      <div class="section-mini">Featured</div>
      <h2>Signature Picks</h2>
    </div>
  </div>

  <div class="featured-grid">
    <% featuredProducts.forEach(function(product){ %>
      <article class="featured-card">
        <a href="/product/<%= product.slug %>">
          <img src="<%= product.image %>" alt="<%= product.name %>">
        </a>

        <div class="featured-body">
          <div class="featured-badge">Top Seller</div>
          <h3><a href="/product/<%= product.slug %>"><%= product.name %></a></h3>

          <div class="featured-footer">
            <strong>Rp <%= Number(product.price).toLocaleString('id-ID') %></strong>
            <a href="/product/<%= product.slug %>">View</a>
          </div>
        </div>
      </article>
    <% }) %>
  </div>
</section>
<% } %>

<main class="wrap home-products-wrap" id="productsSection">
  <div class="collection-head">
    <div>
      <div class="collection-label">Collection</div>
      <h2 class="collection-title">All Fragrance</h2>
    </div>
    <div class="muted result-info"><%= products.length %> produk aktif</div>
  </div>

  <section class="products-grid-home">
    <% products.forEach(function(product){ %>
      <article class="product-card-home">
        <a href="/product/<%= product.slug %>">
          <img src="<%= product.image %>" alt="<%= product.name %>" class="product-image">
        </a>

        <div class="product-body">
          <h3 class="product-name">
            <a href="/product/<%= product.slug %>"><%= product.name %></a>
          </h3>

          <div class="product-price">
            Rp <%= Number(product.price).toLocaleString('id-ID') %>
          </div>

          <a class="detail-btn" href="/product/<%= product.slug %>">Detail</a>
        </div>
      </article>
    <% }) %>
  </section>
</main>

<style>
.hero-premium{
  padding:80px 0;
  text-align:center;
  background:linear-gradient(#fffdf9,#ffffff);
  border-bottom:1px solid #ece8e1;
}

.hero-premium h1{
  font-size:46px;
  letter-spacing:.25em;
}

.hero-premium p{
  max-width:600px;
  margin:14px auto;
  color:#666;
}

.btn-gold{
  padding:12px 24px;
  border-radius:999px;
  background:linear-gradient(#f5e6c7,#e3c085);
  border:1px solid rgba(216,179,106,.4);
  font-size:11px;
  letter-spacing:.1em;
}

.featured-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:18px;
}

.featured-card{
  border:1px solid #ece8e1;
  border-radius:18px;
  overflow:hidden;
  background:#fff;
}

.featured-card img{
  width:100%;
  aspect-ratio:4/5;
  object-fit:cover;
}

.featured-body{
  padding:14px;
}

.products-grid-home{
  display:grid;
  grid-template-columns:repeat(5,1fr);
  gap:16px;
}

.product-card-home{
  border:1px solid #ece8e1;
  border-radius:16px;
  overflow:hidden;
  background:#fff;
}

.product-image{
  width:100%;
  aspect-ratio:3/4;
  object-fit:cover;
}

.product-body{
  padding:10px;
}

.product-name{
  font-size:13px;
}

.product-price{
  color:#7a2946;
  font-size:13px;
  margin:4px 0;
}

.detail-btn{
  display:block;
  text-align:center;
  padding:6px;
  border:1px solid #ece8e1;
  border-radius:10px;
  font-size:10px;
}

@media (max-width:900px){
  .featured-grid{
    grid-template-columns:repeat(2,1fr);
  }

  .products-grid-home{
    grid-template-columns:repeat(3,1fr);
  }
}

@media (max-width:600px){
  .featured-grid{
    grid-template-columns:repeat(2,1fr);
  }

  .products-grid-home{
    grid-template-columns:repeat(2,1fr);
  }

  .hero-premium h1{
    font-size:26px;
    letter-spacing:.15em;
  }
}
</style>
