    }
  }

  @media (max-width:900px){
    .featured-grid{
      grid-template-columns:repeat(2, minmax(0, 1fr));
    }

    .products-grid-home{
      grid-template-columns:repeat(3, minmax(0, 1fr));
    }

    .hero-premium h1{
      font-size:42px;
      letter-spacing:.20em;
    }
  }

  @media (max-width:600px){
    .hero-premium{
      min-height:auto;
    }

    .hero-premium-inner{
      padding-top:56px;
      padding-bottom:56px;
    }

    .hero-mini,
    .section-mini,
    .collection-label{
      font-size:10px;
      letter-spacing:.12em;
    }

    .hero-premium h1{
      font-size:28px;
      letter-spacing:.14em;
    }

    .hero-premium p{
      font-size:13px;
      line-height:1.8;
      margin-top:14px;
    }

    .hero-actions{
      margin-top:22px;
      gap:10px;
    }

    .btn-premium{
      width:100%;
      min-height:42px;
      font-size:10px;
    }

    .brand-note-row{
      min-height:auto;
      padding:12px 0;
      gap:10px;
    }

    .brand-note-item{
      font-size:9px;
      letter-spacing:.10em;
    }

    .brand-note-line{
      width:10px;
    }

    .featured-section,
    .about-home-section,
    .home-products-wrap,
    .closing-section{
      padding-left:14px;
      padding-right:14px;
    }

    .section-head-clean h2,
    .about-home-card h2,
    .closing-card h2{
      font-size:20px;
      letter-spacing:.08em;
    }

    .featured-grid{
      grid-template-columns:1fr;
      gap:14px;
    }

    .about-home-card{
      padding:24px 16px;
      border-radius:20px;
    }

    .about-home-card p,
    .closing-card p{
      font-size:13px;
      line-height:1.8;
    }

    .products-grid-home{
      grid-template-columns:repeat(2, minmax(0, 1fr));
      gap:12px;
    }

    .collection-title{
      font-size:18px;
      letter-spacing:.08em;
    }

    .product-card-home{
      border-radius:14px;
    }

    .product-body{
      padding:8px;
    }

    .product-badges{
      gap:4px;
      margin-bottom:6px;
    }

    .product-pill{
      font-size:8px;
      padding:3px 6px;
    }

    .product-name{
      font-size:11px;
      margin-bottom:4px;
    }

    .product-desc{
      display:none;
    }

    .product-price{
      font-size:11px;
    }

    .product-footer{
      gap:6px;
      padding-top:8px;
    }

    .detail-btn,
    .add-btn{
      min-height:32px;
      font-size:10px;
      border-radius:10px;
      padding:0 8px;
    }
  }
</style>
