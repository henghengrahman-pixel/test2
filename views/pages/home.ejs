<section class="hero">
  <h1>MAWAR PARFUME</h1>
  <p>Extrait de parfum halal, wangi mewah, dan tahan lama.</p>
</section>

<main class="wrap home-products-wrap">
  <div class="collection-head">
    <div>
      <div class="collection-label">Collection</div>
      <h2 class="collection-title">Signature Fragrance</h2>
    </div>
    <div class="muted result-info" id="resultInfo"><%= products.length %> produk aktif</div>
  </div>

  <% if (products && products.length) { %>
    <section class="products-grid products-grid-home" id="productsGrid">
      <% products.forEach(function(product){ %>
        <article
          class="product-card product-card-home"
          data-name="<%= product.name %>"
          data-category="<%= product.category %>"
          data-badge="<%= product.badge %>"
        >
          <a href="/product/<%= product.slug %>" class="product-image-link" aria-label="<%= product.name %>">
            <div class="product-image-wrap">
              <img
                src="<%= product.image %>"
                alt="<%= product.name %>"
                class="product-image"
                loading="lazy"
              >
            </div>
          </a>

          <div class="product-body">
            <div class="product-badges">
              <% if (product.badge) { %>
                <span class="product-pill"><%= product.badge %></span>
              <% } %>

              <% if (product.topSeller) { %>
                <span class="product-pill">TOP SELLER</span>
              <% } %>

              <% if (product.soldOut) { %>
                <span class="product-pill soldout-pill">SOLD OUT</span>
              <% } %>

              <% if (product.category) { %>
                <span class="product-pill category-pill"><%= product.category %></span>
              <% } %>
            </div>

            <h3 class="product-name">
              <a href="/product/<%= product.slug %>"><%= product.name %></a>
            </h3>

            <div class="product-desc"><%= product.desc %></div>

            <div class="product-footer">
              <strong class="product-price">
                Rp <%= Number(product.price).toLocaleString('id-ID') %>
              </strong>

              <div class="product-actions">
                <a class="checkout-link detail-btn" href="/product/<%= product.slug %>">Detail</a>

                <button
                  class="iconbtn add-cart add-btn"
                  type="button"
                  data-id="<%= product.id %>"
                  data-name="<%= product.name %>"
                  data-price="<%= product.price %>"
                  data-image="<%= product.image %>"
                  <%= product.soldOut ? 'disabled' : '' %>
                >
                  <%= product.soldOut ? 'Sold Out' : 'Add' %>
                </button>
              </div>
            </div>
          </div>
        </article>
      <% }) %>
    </section>
  <% } else { %>
    <section class="empty-products">
      <div class="empty-products-card">
        <h3>Produk belum tersedia</h3>
        <p class="muted">Saat ini belum ada produk aktif yang ditampilkan.</p>
      </div>
    </section>
  <% } %>
</main>

<style>
  .home-products-wrap{
    padding:28px 18px 54px;
  }

  .collection-head{
    display:flex;
    justify-content:space-between;
    gap:12px;
    align-items:end;
    flex-wrap:wrap;
    margin-bottom:18px;
  }

  .collection-label{
    font-size:12px;
    letter-spacing:.12em;
    text-transform:uppercase;
    color:rgba(255,255,255,.68);
  }

  .collection-title{
    margin:6px 0 0;
    font-size:18px;
    letter-spacing:.18em;
    text-transform:uppercase;
    color:#fff4d6;
  }

  .result-info{
    font-size:12px;
  }

  .products-grid-home{
    display:grid;
    grid-template-columns:repeat(5, minmax(0, 1fr));
    gap:16px;
  }

  @media (max-width: 1200px){
    .products-grid-home{
      grid-template-columns:repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px){
    .products-grid-home{
      grid-template-columns:repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px){
    .products-grid-home{
      grid-template-columns:repeat(3, minmax(0, 1fr));
      gap:10px;
    }
  }

  .product-card-home{
    border:1px solid rgba(255,255,255,.08);
    border-radius:16px;
    overflow:hidden;
    background:rgba(255,255,255,.04);
    box-shadow:var(--lux-shadow2);
    transition:transform .18s ease, box-shadow .18s ease, border-color .18s ease;
    display:flex;
    flex-direction:column;
    min-height:100%;
  }

  .product-card-home:hover{
    transform:translateY(-4px);
    box-shadow:0 18px 34px rgba(0,0,0,.22);
    border-color:rgba(231,192,107,.22);
  }

  .product-image-link{
    display:block;
  }

  .product-image-wrap{
    position:relative;
    overflow:hidden;
    background:rgba(255,255,255,.03);
  }

  .product-image{
    width:100%;
    aspect-ratio:3/4;
    object-fit:cover;
    display:block;
    transition:transform .35s ease;
  }

  .product-card-home:hover .product-image{
    transform:scale(1.04);
  }

  .product-body{
    padding:14px;
    display:flex;
    flex-direction:column;
    flex:1;
  }

  .product-badges{
    display:flex;
    gap:6px;
    flex-wrap:wrap;
    margin-bottom:8px;
  }

  .product-pill{
    padding:5px 9px;
    border-radius:999px;
    border:1px solid rgba(231,192,107,.35);
    color:#fff4d6;
    font-size:10px;
    line-height:1;
    letter-spacing:.08em;
    text-transform:uppercase;
    background:rgba(255,255,255,.03);
  }

  .soldout-pill{
    border-color:rgba(255,120,120,.35);
    color:#ffd0d0;
  }

  .category-pill{
    border-color:rgba(120,180,255,.20);
    color:#dbe9ff;
  }

  .product-name{
    margin:0 0 8px;
    font-size:16px;
    line-height:1.35;
    letter-spacing:.04em;
  }

  .product-name a{
    color:#fff;
    text-decoration:none;
  }

  .product-name a:hover{
    color:#fff4d6;
  }

  .product-desc{
    font-size:13px;
    line-height:1.6;
    color:rgba(255,255,255,.72);
    min-height:42px;
  }

  .product-footer{
    margin-top:auto;
    display:flex;
    flex-direction:column;
    align-items:stretch;
    gap:10px;
    padding-top:14px;
  }

  .product-price{
    color:#fff4d6;
    font-size:17px;
    line-height:1.2;
  }

  .product-actions{
    display:flex;
    gap:8px;
    flex-wrap:wrap;
  }

  .detail-btn{
    text-decoration:none;
    justify-content:center;
    flex:1;
    min-width:0;
  }

  .add-btn{
    width:auto;
    padding:0 14px;
    min-width:70px;
    flex:1;
  }

  .add-btn[disabled]{
    opacity:.55;
    cursor:not-allowed;
  }

  .empty-products{
    padding:10px 0 0;
  }

  .empty-products-card{
    border:1px solid rgba(255,255,255,.08);
    border-radius:20px;
    background:rgba(255,255,255,.04);
    padding:24px;
    text-align:center;
  }

  @media (max-width: 600px){
    .home-products-wrap{
      padding:22px 14px 46px;
    }

    .collection-head{
      margin-bottom:14px;
    }

    .collection-label{
      font-size:10px;
    }

    .collection-title{
      font-size:14px;
      letter-spacing:.12em;
    }

    .result-info{
      font-size:10px;
    }

    .product-card-home{
      border-radius:12px;
    }

    .product-body{
      padding:8px;
    }

    .product-badges{
      gap:4px;
      margin-bottom:6px;
    }

    .product-pill{
      font-size:8px;
      padding:3px 6px;
      letter-spacing:.05em;
    }

    .product-name{
      font-size:11px;
      margin:0 0 4px;
      line-height:1.3;
    }

    .product-desc{
      display:none;
    }

    .product-price{
      font-size:11px;
    }

    .product-footer{
      gap:6px;
      padding-top:8px;
    }

    .product-actions{
      flex-direction:column;
      gap:6px;
    }

    .detail-btn,
    .add-btn{
      width:100%;
      min-width:0;
      font-size:10px;
      min-height:32px;
      padding:0 8px;
      border-radius:10px;
    }

    .iconbtn.add-btn{
      height:32px;
    }
  }
</style>
