
<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('../partials/head') %>
</head>
<body class="<%= currentPath.startsWith('/admin') ? 'admin' : 'site' %>">
  <% if (!currentPath.startsWith('/admin')) { %>
    <%- include('../partials/header') %>
  <% } %>
  <%- body %>
  <% if (!currentPath.startsWith('/admin')) { %>
    <%- include('../partials/footer') %>
  <% } %>
  <%- include('../partials/scripts') %>
</body>
</html>
