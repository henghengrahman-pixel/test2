<footer class="site footer-lux">
  <div class="footer-glow"></div>

  <div class="wrap footer-wrap-lux">
    <div class="footer-brand-col">
      <div class="footer-kicker">Luxury Extrait de Parfum</div>

      <div class="footer-brand">
        <span class="footer-mark">✦</span>
        <span class="footer-brand-text">Mawar Parfume Official Store</span>
        <span class="footer-mark">✦</span>
      </div>

      <p class="footer-desc">
        <%= siteSettings.footerText %>
      </p>

      <div class="footer-tags">
        <span>Halal</span>
        <span>Long Lasting</span>
        <span>Premium Quality</span>
        <span>Elegant Aroma</span>
      </div>
    </div>

    <div class="footer-links-col">
      <div class="footer-mini-title">Quick Access</div>

      <div class="footer-actions">
        <a class="footer-btn footer-btn-gold" href="<%= siteSettings.whatsappLink %>" target="_blank" rel="noopener">
          WhatsApp
        </a>
        <a class="footer-btn footer-btn-dark" href="/admin">
          Admin
        </a>
      </div>

      <div class="footer-links-grid">
        <a href="/">Home</a>
        <a href="/checkout">Checkout</a>
        <a href="/admin">Dashboard</a>
        <a href="<%= siteSettings.whatsappLink %>" target="_blank" rel="noopener">Contact</a>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="wrap footer-bottom-row">
      <div>© <%= new Date().getFullYear() %> Mawar Parfume. All rights reserved.</div>
      <div class="footer-bottom-right">Luxury Fragrance • Premium Experience</div>
    </div>
  </div>
</footer>

<style>
  .footer-lux{
    position:relative;
    overflow:hidden;
    margin-top:56px;
    border-top:1px solid rgba(255,255,255,.06);
    background:
      radial-gradient(800px 240px at 50% 0%, rgba(231,192,107,.10), transparent 65%),
      linear-gradient(180deg, rgba(12,12,16,.96), rgba(8,8,12,.98));
  }

  .footer-glow{
    position:absolute;
    inset:0;
    pointer-events:none;
    background:
      radial-gradient(600px 180px at 15% 20%, rgba(122,41,70,.10), transparent 60%),
      radial-gradient(600px 180px at 85% 20%, rgba(15,122,85,.08), transparent 60%);
  }

  .footer-wrap-lux{
    position:relative;
    z-index:2;
    display:grid;
    grid-template-columns:1.2fr .8fr;
    gap:28px;
    align-items:start;
    padding:34px 18px 26px;
  }

  .footer-kicker{
    font-size:11px;
    letter-spacing:.18em;
    text-transform:uppercase;
    color:rgba(255,226,163,.72);
    margin-bottom:12px;
  }

  .footer-brand{
    display:flex;
    align-items:center;
    gap:10px;
    flex-wrap:wrap;
  }

  .footer-mark{
    color:#e7c06b;
    font-size:12px;
    opacity:.88;
  }

  .footer-brand-text{
    font-weight:900;
    letter-spacing:.20em;
    text-transform:uppercase;
    color:#fff4d6;
    font-size:20px;
    line-height:1.4;
  }

  .footer-desc{
    margin:14px 0 0;
    max-width:620px;
    color:rgba(255,255,255,.72);
    line-height:1.9;
    font-size:14px;
  }

  .footer-tags{
    display:flex;
    gap:10px;
    flex-wrap:wrap;
    margin-top:18px;
  }

  .footer-tags span{
    display:inline-flex;
    align-items:center;
    min-height:34px;
    padding:0 12px;
    border-radius:999px;
    border:1px solid rgba(231,192,107,.20);
    background:rgba(255,255,255,.03);
    color:#ffe2a3;
    font-size:10px;
    letter-spacing:.10em;
    text-transform:uppercase;
  }

  .footer-links-col{
    text-align:right;
  }

  .footer-mini-title{
    font-size:11px;
    letter-spacing:.18em;
    text-transform:uppercase;
    color:rgba(255,226,163,.72);
    margin-bottom:12px;
  }

  .footer-actions{
    display:flex;
    gap:10px;
    justify-content:flex-end;
    flex-wrap:wrap;
    margin-bottom:16px;
  }

  .footer-btn{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    min-height:40px;
    padding:0 16px;
    border-radius:999px;
    font-size:11px;
    font-weight:900;
    letter-spacing:.10em;
    text-transform:uppercase;
    transition:.22s ease;
  }

  .footer-btn-gold{
    border:1px solid rgba(255,226,163,.42);
    background:linear-gradient(180deg, rgba(255,226,163,.94), rgba(231,192,107,.82));
    color:#1b1208;
    box-shadow:0 10px 24px rgba(0,0,0,.18);
  }

  .footer-btn-gold:hover{
    transform:translateY(-1px);
  }

  .footer-btn-dark{
    border:1px solid rgba(255,255,255,.10);
    background:rgba(255,255,255,.05);
    color:#fff4d6;
  }

  .footer-btn-dark:hover{
    border-color:rgba(231,192,107,.26);
    background:rgba(255,255,255,.08);
  }

  .footer-links-grid{
    display:grid;
    gap:10px;
    justify-content:end;
  }

  .footer-links-grid a{
    color:rgba(255,255,255,.74);
    font-size:13px;
    transition:.2s ease;
  }

  .footer-links-grid a:hover{
    color:#fff4d6;
  }

  .footer-bottom{
    position:relative;
    z-index:2;
    border-top:1px solid rgba(255,255,255,.06);
    background:rgba(255,255,255,.02);
  }

  .footer-bottom-row{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:12px;
    flex-wrap:wrap;
    padding:14px 18px;
    color:rgba(255,255,255,.56);
    font-size:12px;
  }

  .footer-bottom-right{
    letter-spacing:.08em;
    text-transform:uppercase;
    color:rgba(255,226,163,.62);
  }

  @media (max-width:900px){
    .footer-wrap-lux{
      grid-template-columns:1fr;
      gap:22px;
    }

    .footer-links-col{
      text-align:left;
    }

    .footer-actions{
      justify-content:flex-start;
    }

    .footer-links-grid{
      justify-content:start;
    }
  }

  @media (max-width:600px){
    .footer-lux{
      margin-top:42px;
    }

    .footer-wrap-lux{
      padding:24px 14px 20px;
      gap:18px;
    }

    .footer-kicker,
    .footer-mini-title{
      font-size:10px;
      letter-spacing:.12em;
      margin-bottom:10px;
    }

    .footer-brand{
      gap:8px;
    }

    .footer-brand-text{
      font-size:15px;
      letter-spacing:.12em;
    }

    .footer-mark{
      font-size:10px;
    }

    .footer-desc{
      font-size:13px;
      line-height:1.8;
      margin-top:12px;
    }

    .footer-tags{
      gap:8px;
      margin-top:14px;
    }

    .footer-tags span{
      min-height:30px;
      padding:0 10px;
      font-size:9px;
    }

    .footer-actions{
      gap:8px;
      margin-bottom:14px;
    }

    .footer-btn{
      width:100%;
      min-height:38px;
      font-size:10px;
    }

    .footer-links-grid{
      gap:8px;
    }

    .footer-links-grid a{
      font-size:12px;
    }

    .footer-bottom-row{
      padding:12px 14px;
      font-size:11px;
    }

    .footer-bottom-right{
      font-size:10px;
      letter-spacing:.06em;
    }
  }
</style>
