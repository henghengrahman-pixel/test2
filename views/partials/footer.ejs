<footer class="site footer-clean-lux">
  <div class="wrap footer-clean-wrap">
    <div class="footer-clean-top">
      <div class="footer-brand-block">
        <div class="footer-mini">Luxury Extrait de Parfum</div>
        <div class="footer-brand-name">MAWAR PARFUME</div>
        <p class="footer-desc">
          <%= siteSettings.footerText %>
        </p>
      </div>

      <div class="footer-action-block">
        <a
          class="footer-wa-btn"
          href="<%= siteSettings.whatsappLink %>"
          target="_blank"
          rel="noopener"
        >
          WhatsApp
        </a>
      </div>
    </div>

    <div class="footer-divider"></div>

    <div class="footer-links-row">
      <a href="/">Home</a>
      <a href="/#productsSection">Collection</a>
      <a href="/checkout">Checkout</a>
      <a href="<%= siteSettings.whatsappLink %>" target="_blank" rel="noopener">Contact</a>
    </div>

    <div class="footer-divider soft"></div>

    <div class="footer-bottom-row">
      <div>© <%= new Date().getFullYear() %> Mawar Parfume</div>
      <div class="footer-bottom-tag">Elegant Scent • Premium Experience</div>
    </div>
  </div>
</footer>

<style>
  .footer-clean-lux{
    margin-top:52px;
    border-top:1px solid rgba(255,255,255,.06);
    background:
      radial-gradient(700px 180px at 50% 0%, rgba(231,192,107,.08), transparent 65%),
      linear-gradient(180deg, rgba(10,10,14,.96), rgba(8,8,12,.98));
  }

  .footer-clean-wrap{
    padding:34px 18px 20px;
  }

  .footer-clean-top{
    display:grid;
    grid-template-columns:1.2fr .8fr;
    gap:24px;
    align-items:end;
  }

  .footer-brand-block{
    max-width:700px;
  }

  .footer-mini{
    font-size:11px;
    letter-spacing:.18em;
    text-transform:uppercase;
    color:rgba(255,226,163,.72);
    margin-bottom:10px;
  }

  .footer-brand-name{
    color:#fff4d6;
    font-size:24px;
    font-weight:900;
    letter-spacing:.22em;
    text-transform:uppercase;
    line-height:1.3;
  }

  .footer-desc{
    margin:12px 0 0;
    color:rgba(255,255,255,.70);
    font-size:14px;
    line-height:1.9;
  }

  .footer-action-block{
    display:flex;
    justify-content:flex-end;
    align-items:center;
  }

  .footer-wa-btn{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    min-height:42px;
    padding:0 18px;
    border-radius:999px;
    border:1px solid rgba(231,192,107,.28);
    background:rgba(255,255,255,.03);
    color:#ffe2a3;
    font-size:11px;
    font-weight:800;
    letter-spacing:.10em;
    text-transform:uppercase;
    transition:.22s ease;
  }

  .footer-wa-btn:hover{
    border-color:rgba(231,192,107,.44);
    background:rgba(255,255,255,.06);
    color:#fff4d6;
    transform:translateY(-1px);
  }

  .footer-divider{
    height:1px;
    background:rgba(255,255,255,.06);
    margin:22px 0 18px;
  }

  .footer-divider.soft{
    margin:18px 0 14px;
    background:rgba(255,255,255,.04);
  }

  .footer-links-row{
    display:flex;
    justify-content:center;
    align-items:center;
    gap:24px;
    flex-wrap:wrap;
  }

  .footer-links-row a{
    color:rgba(255,255,255,.72);
    font-size:12px;
    letter-spacing:.10em;
    text-transform:uppercase;
    transition:.2s ease;
  }

  .footer-links-row a:hover{
    color:#fff4d6;
  }

  .footer-bottom-row{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:12px;
    flex-wrap:wrap;
    color:rgba(255,255,255,.50);
    font-size:12px;
  }

  .footer-bottom-tag{
    color:rgba(255,226,163,.62);
    letter-spacing:.08em;
    text-transform:uppercase;
  }

  @media (max-width:900px){
    .footer-clean-top{
      grid-template-columns:1fr;
      align-items:start;
      gap:18px;
    }

    .footer-action-block{
      justify-content:flex-start;
    }

    .footer-brand-name{
      font-size:20px;
      letter-spacing:.18em;
    }
  }

  @media (max-width:600px){
    .footer-clean-lux{
      margin-top:40px;
    }

    .footer-clean-wrap{
      padding:24px 14px 18px;
    }

    .footer-mini{
      font-size:10px;
      letter-spacing:.12em;
      margin-bottom:8px;
    }

    .footer-brand-name{
      font-size:16px;
      letter-spacing:.14em;
    }

    .footer-desc{
      margin-top:10px;
      font-size:13px;
      line-height:1.8;
    }

    .footer-wa-btn{
      width:100%;
      min-height:40px;
      font-size:10px;
    }

    .footer-links-row{
      gap:14px;
    }

    .footer-links-row a{
      font-size:10px;
      letter-spacing:.08em;
    }

    .footer-bottom-row{
      font-size:11px;
      flex-direction:column;
      align-items:flex-start;
    }

    .footer-bottom-tag{
      font-size:10px;
      letter-spacing:.06em;
    }
  }
</style>
