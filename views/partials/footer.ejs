        <p class="footer-desc">
          <%= siteSettings.footerText %>
        </p>
      </div>
    </div>

    <div class="footer-divider"></div>

    <div class="footer-links-row reveal">
      <a href="/" class="footer-link-fx">Home</a>
      <a href="/#productsSection" class="footer-link-fx">Collection</a>
      <a href="/checkout" class="footer-link-fx">Checkout</a>
