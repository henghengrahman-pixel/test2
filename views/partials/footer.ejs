<footer class="site footer-clean-lux reveal">
  <div class="wrap footer-clean-wrap">
    <div class="footer-clean-top">
      <div class="footer-brand-block reveal-left">
        <div class="footer-mini">Luxury Extrait de Parfum</div>
        <div class="footer-brand-name">MAWAR PARFUME</div>
        <p class="footer-desc">
          <%= siteSettings.footerText %>
        </p>
      </div>

      <div class="footer-action-block reveal-right">
        <a
          class="footer-wa-btn magnetic"
          href="<%= siteSettings.whatsappLink %>"
          target="_blank"
          rel="noopener"
        >
          WhatsApp
        </a>
      </div>
    </div>

    <div class="footer-divider"></div>

    <div class="footer-links-row reveal">
      <a href="/" class="footer-link-fx">Home</a>
      <a href="/#productsSection" class="footer-link-fx">Collection</a>
      <a href="/checkout" class="footer-link-fx">Checkout</a>
      <a href="<%= siteSettings.whatsappLink %>" target="_blank" rel="noopener" class="footer-link-fx">Contact</a>
    </div>

    <div class="footer-divider soft"></div>

    <div class="footer-bottom-row reveal reveal-zoom">
      <div>© <%= new Date().getFullYear() %> Mawar Parfume</div>
      <div class="footer-bottom-tag">Elegant Scent • Premium Experience</div>
    </div>
  </div>
</footer>

<style>
  .footer-clean-lux{
    margin-top:52px;
    border-top:1px solid #ece8e1;
    background:
      radial-gradient(700px 180px at 50% 0%, rgba(216,179,106,.10), transparent 65%),
      linear-gradient(180deg, #fffdf9, #ffffff);
  }

  .footer-clean-wrap{
    padding:34px 18px 20px;
  }

  .footer-clean-top{
    display:grid;
    grid-template-columns:1.2fr .8fr;
    gap:24px;
    align-items:end;
  }

  .footer-brand-block{
    max-width:700px;
  }

  .footer-mini{
    font-size:11px;
    letter-spacing:.18em;
    text-transform:uppercase;
    color:#9a7440;
    margin-bottom:10px;
  }

  .footer-brand-name{
    color:#181818;
    font-size:24px;
    font-weight:900;
    letter-spacing:.22em;
    text-transform:uppercase;
    line-height:1.3;
  }

  .footer-desc{
    margin:12px 0 0;
    color:#666;
    font-size:14px;
    line-height:1.9;
    max-width:620px;
  }

  .footer-action-block{
    display:flex;
    justify-content:flex-end;
    align-items:center;
  }

  .footer-wa-btn{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    min-height:42px;
    padding:0 18px;
    border-radius:999px;
    border:1px solid rgba(216,179,106,.42);
    background:linear-gradient(180deg, #f5e7ca, #e7c98f);
    color:#31210b;
    font-size:11px;
    font-weight:800;
    letter-spacing:.10em;
    text-transform:uppercase;
    box-shadow:0 8px 18px rgba(216,179,106,.16);
    transition:transform .25s ease, box-shadow .25s ease, filter .25s ease;
  }

  .footer-wa-btn:hover{
    transform:translateY(-2px);
    box-shadow:0 14px 26px rgba(216,179,106,.22);
  }

  .footer-divider{
    height:1px;
    background:#ece8e1;
    margin:22px 0 18px;
  }

  .footer-divider.soft{
    margin:18px 0 14px;
    background:#f2eee7;
  }

  .footer-links-row{
    display:flex;
    justify-content:center;
    align-items:center;
    gap:24px;
    flex-wrap:wrap;
  }

  .footer-links-row a{
    color:#666;
    font-size:12px;
    letter-spacing:.10em;
    text-transform:uppercase;
    transition:color .22s ease, transform .22s ease;
  }

  .footer-links-row a:hover{
    color:#111;
    transform:translateY(-1px);
  }

  .footer-link-fx{
    position:relative;
  }

  .footer-link-fx::after{
    content:"";
    position:absolute;
    left:0;
    right:0;
    bottom:-4px;
    height:1px;
    background:rgba(216,179,106,.7);
    transform:scaleX(0);
    transform-origin:center;
    transition:transform .25s ease;
  }

  .footer-link-fx:hover::after{
    transform:scaleX(1);
  }

  .footer-bottom-row{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:12px;
    flex-wrap:wrap;
    color:#888;
    font-size:12px;
  }

  .footer-bottom-tag{
    color:#9a7440;
    letter-spacing:.08em;
    text-transform:uppercase;
  }

  @media (max-width:900px){
    .footer-clean-top{
      grid-template-columns:1fr;
      align-items:start;
      gap:18px;
    }

    .footer-action-block{
      justify-content:flex-start;
    }

    .footer-brand-name{
      font-size:20px;
      letter-spacing:.18em;
    }
  }

  @media (max-width:600px){
    .footer-clean-lux{
      margin-top:40px;
    }

    .footer-clean-wrap{
      padding:24px 14px 18px;
    }

    .footer-mini{
      font-size:10px;
      letter-spacing:.12em;
      margin-bottom:8px;
    }

    .footer-brand-name{
      font-size:16px;
      letter-spacing:.14em;
    }

    .footer-desc{
      margin-top:10px;
      font-size:13px;
      line-height:1.8;
    }

    .footer-wa-btn{
      width:100%;
      min-height:40px;
      font-size:10px;
    }

    .footer-links-row{
      gap:14px;
    }

    .footer-links-row a{
      font-size:10px;
      letter-spacing:.08em;
    }

    .footer-bottom-row{
      font-size:11px;
      flex-direction:column;
      align-items:flex-start;
    }

    .footer-bottom-tag{
      font-size:10px;
      letter-spacing:.06em;
    }
  }

  @media (prefers-reduced-motion: reduce){
    .footer-wa-btn,
    .footer-links-row a,
    .footer-link-fx::after{
      transition:none !important;
      transform:none !important;
    }
  }
</style>
