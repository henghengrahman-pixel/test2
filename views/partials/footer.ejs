
<footer class="site" style="border-top:1px solid var(--lux-line);padding:22px 0;margin-top:40px;">
  <div class="wrap" style="display:grid;grid-template-columns:1.2fr .8fr;gap:18px;align-items:start;">
    <div>
      <div style="font-weight:900;letter-spacing:.22em;text-transform:uppercase;color:#fff4d6;">Mawar Parfume Official Store</div>
      <div style="margin-top:6px;color:rgba(255,255,255,.72);"><%= siteSettings.footerText %></div>
    </div>
    <div style="text-align:right;display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap;">
      <a class="checkout-link" href="<%= siteSettings.whatsappLink %>" target="_blank" rel="noopener">WhatsApp</a>
      <a class="checkout-link" href="/admin">Admin</a>
    </div>
  </div>
</footer>
