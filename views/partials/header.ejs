<div class="top-strip top-strip-clean reveal reveal-zoom">
  <div class="wrap">
    <div class="strip-row">
      <div class="strip-left">Extrait de Parfum</div>

      <div class="strip-right">
        <span
          class="cartlink magnetic"
          onclick="window.MawarCart.toggle()"
          role="button"
          tabindex="0"
        >
          Cart <b id="cartCount">0</b>
        </span>
      </div>
    </div>
  </div>
</div>

<header class="header header-clean">
  <div class="wrap">
    <div class="row row-clean">
      <h1 class="brand" style="margin:0">
        <a href="/" class="brand-link-clean brand-hover" aria-label="Mawar Parfume Home">
          <span class="brand-text-clean">MAWAR PARFUME</span>
        </a>
      </h1>

      <div class="head-actions">
        <button class="iconbtn-clean magnetic" id="openSearchBtn" type="button" aria-label="Open search">
          ⌕
        </button>
      </div>
    </div>
  </div>

  <div class="nav nav-clean" id="mainNav">
    <ul>
      <li>
        <a
          href="/"
          class="nav-item-fx <%= !currentPath.includes('?category=') ? '' : '' %>"
        >
          Fragrance
        </a>
      </li>
      <li>
        <a href="/?category=MIX" data-filter="MIX" class="cat-link nav-item-fx">Parfume Mix</a>
      </li>
      <li>
        <a href="/?category=MEN" data-filter="MEN" class="cat-link nav-item-fx">Men</a>
      </li>
      <li>
        <a href="/?category=WOMEN" data-filter="WOMEN" class="cat-link nav-item-fx">Women</a>
      </li>
      <li>
        <a href="/?category=UNISEX" data-filter="UNISEX" class="cat-link nav-item-fx">Unisex</a>
      </li>
    </ul>
  </div>
</header>

<div class="search-overlay search-overlay-clean" id="searchOverlay" aria-hidden="true">
  <div class="searchbar searchbar-clean reveal-zoom">
    <div class="searchhint">Search fragrance</div>

    <div class="searchrow searchrow-clean">
      <span class="sicon">⌕</span>
      <input id="q" placeholder="Search perfume..." autocomplete="off" inputmode="search">
    </div>

    <button class="closebtn cleanbtn magnetic" id="closeSearchBtn" type="button">Close</button>
  </div>
</div>

<div id="cartDrawer" class="cartDrawerClean" aria-hidden="true" style="position:fixed;inset:0;z-index:2000;display:none;">
  <div class="cart-backdrop" onclick="window.MawarCart.toggle(false)"></div>

  <aside class="cart-panel">
    <div class="cart-panel-head">
      <h3>My Cart</h3>
      <button class="iconbtn-clean magnetic" type="button" onclick="window.MawarCart.toggle(false)">✕</button>
    </div>

    <div id="cartDrawerItems" class="muted cart-items-clean"></div>

    <div class="cart-panel-actions">
      <a class="cart-checkout-btn magnetic" href="/checkout">Checkout</a>
      <button class="iconbtn-clean clear-cart-btn magnetic" type="button" onclick="window.MawarCart.clear()">Kosongkan</button>
    </div>
  </aside>
</div>

<style>
