    }

    .cartDrawerClean .cart-panel{
      width:100%;
      padding:18px 16px;
    }
  }

  @media (prefers-reduced-motion: reduce){
    .magnetic,
    .nav-item-fx::after,
    .iconbtn-clean,
    .nav-clean a,
    .cartlink,
    .brand-text-clean,
    .reveal,
    .reveal-zoom{
      animation:none !important;
      transition:none !important;
      transform:none !important;
    }
  }
</style>
