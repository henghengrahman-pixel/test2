  }

  .brand-link-clean{
    color:#1a1a1a;
    text-decoration:none;
  }

  .brand-text-clean{
    display:inline-block;
    color:#1a1a1a;
    font-size:20px;
    font-weight:900;
    letter-spacing:.24em;
    text-transform:uppercase;
    line-height:1.2;
    transition:transform .35s ease, letter-spacing .35s ease;
  }

  .brand-hover:hover .brand-text-clean{
    transform:translateY(-1px);
    letter-spacing:.26em;
  }

  .iconbtn-clean,
  .cleanbtn{
    width:36px;
    height:36px;
    border-radius:10px;
    border:1px solid #ece8e1;
    background:#fff;
    color:#1c1c1c;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    box-shadow:0 6px 18px rgba(0,0,0,.04);
    transition:transform .25s ease, background .25s ease, border-color .25s ease, box-shadow .25s ease;
  }

  .cleanbtn{
    width:auto;
    min-height:36px;
    padding:0 14px;
  }

  .iconbtn-clean:hover,
  .cleanbtn:hover{
    background:#faf8f4;
    border-color:#ddd5c7;
    box-shadow:0 12px 28px rgba(0,0,0,.08);
  }

