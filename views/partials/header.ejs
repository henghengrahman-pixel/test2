    border-color:rgba(216,179,106,.48);
    background:#faf6ee;
    transform:translateY(-1px);
    box-shadow:0 10px 18px rgba(0,0,0,.05);
  }

  .search-overlay-clean{
    position:fixed;
    inset:0;
    z-index:2100;
    display:none;
    align-items:flex-start;
    justify-content:center;
    padding-top:82px;
    padding-left:16px;
    padding-right:16px;
    background:rgba(255,255,255,.68);
    backdrop-filter:blur(10px);
  }

  .searchbar-clean{
    width:min(720px,100%);
    padding:20px;
    border-radius:20px;
    border:1px solid #ece8e1;
    background:#fff;
    box-shadow:0 24px 60px rgba(0,0,0,.08);
  }

  .searchhint{
    color:#7a7a7a;
    font-size:11px;
    letter-spacing:.14em;
    text-transform:uppercase;
    margin-bottom:10px;
  }

  .searchrow-clean{
    display:flex;
    align-items:center;
    gap:12px;
    min-height:54px;
    padding:0 16px;
    border-radius:16px;
    border:1px solid #ece8e1;
    background:#faf8f4;
    transition:border-color .25s ease, box-shadow .25s ease, background .25s ease;
  }

  .searchrow-clean:focus-within{
    border-color:rgba(216,179,106,.52);
    box-shadow:0 0 0 4px rgba(216,179,106,.12);
    background:#fffdf9;
  }

  .searchrow-clean input{
    flex:1;
    border:none;
    outline:none;
    background:transparent;
    color:#111;
    font-size:15px;
  }

  .searchrow-clean input::placeholder{
    color:#9a9a9a;
  }

  .cartDrawerClean .cart-backdrop{
    position:absolute;
    inset:0;
    background:rgba(255,255,255,.56);
    backdrop-filter:blur(6px);
  }

  .cartDrawerClean .cart-panel{
    position:absolute;
    top:0;
    right:0;
    width:min(420px,100%);
    height:100%;
    padding:20px;
    overflow:auto;
    background:#fff;
    border-left:1px solid #ece8e1;
    box-shadow:-20px 0 50px rgba(0,0,0,.08);
    animation:cartSlideIn .32s ease;
  }

  @keyframes cartSlideIn{
    from{transform:translateX(24px);opacity:.7}
    to{transform:translateX(0);opacity:1}
  }

  .cart-panel-head{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:10px;
    margin-bottom:14px;
  }

  .cart-panel-head h3{
    margin:0;
    color:#1b1b1b;
    font-size:20px;
    letter-spacing:.08em;
    text-transform:uppercase;
  }

  .cart-items-clean{
    color:#666;
  }

  .cart-panel-actions{
    margin-top:16px;
    display:flex;
    gap:10px;
    flex-wrap:wrap;
  }

  .clear-cart-btn{
    width:auto;
    min-height:40px;
    padding:0 14px;
  }

  .cart-checkout-btn{
    min-height:40px;
    padding:0 16px;
    border-radius:12px;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    border:1px solid rgba(216,179,106,.45);
    background:linear-gradient(180deg,#f5e6c7,#e3c085);
    color:#2c1d08;
    font-size:12px;
    font-weight:800;
    letter-spacing:.06em;
    text-transform:uppercase;
    box-shadow:0 8px 18px rgba(216,179,106,.16);
    transition:.2s ease;
    text-decoration:none;
  }

  .cart-checkout-btn:hover{
    transform:translateY(-1px);
  }

  .magnetic{
    will-change:transform;
  }

  .nav-item-fx{
    position:relative;
    overflow:hidden;
  }

  .nav-item-fx::after{
    content:"";
    position:absolute;
    left:14px;
    right:14px;
    bottom:7px;
    height:1px;
    background:rgba(216,179,106,.6);
    transform:scaleX(0);
    transform-origin:center;
    transition:transform .25s ease;
  }

  .nav-item-fx:hover::after{
    transform:scaleX(1);
  }

  .reveal{
    opacity:0;
    transform:translateY(28px);
    transition:opacity .8s ease, transform .8s ease;
    will-change:opacity, transform;
  }

  .reveal.is-visible{
    opacity:1;
    transform:translateY(0);
  }

  .reveal-zoom{
    opacity:0;
    transform:scale(.96);
    transition:opacity .8s ease, transform .8s ease;
  }

  .reveal-zoom.is-visible{
    opacity:1;
    transform:scale(1);
  }

  @media (max-width:900px){
